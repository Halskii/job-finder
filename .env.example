# Copy this file to .env and paste your key. .env is git-ignored. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: federal jobs from USAJobs. Free key: https://developer.usajobs.gov/apirequest (use the same email here)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Optional: Adzuna job search (large US aggregator). Free keys: https://developer.adzuna.com  (then set feeds.adzuna.enabled: true)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: Jooble job search. Free key on request: https://jooble.org/api/about  (then set feeds.jooble.enabled: true)
JOOBLE_API_KEY=
# PostgreSQL, where postings, scores, and the tracker are stored. Create a database and a user for it (see the README), then:
DATABASE_URL=postgresql://jobfinder:your-password@localhost:5432/jobfinder
# Only for running the tests: a separate, empty database (the tests create and drop schemas in it)
TEST_DATABASE_URL=postgresql://jobfinder:your-password@localhost:5432/jobfinder_test
# Sign in with Google: the OAuth client ID (a public value, not a secret) from Google Cloud console > APIs & Services > Credentials.
# Under "Authorized JavaScript origins" add the address you open the site at (http://localhost:8765 here, your real domain later).
GOOGLE_CLIENT_ID=
# Which host names the server answers to (comma separated). Add your domain when you put it online. Default: 127.0.0.1,localhost,[::1]
# ALLOWED_HOSTS=jobs.example.com
# Behind HTTPS (a load balancer), set both so the session cookie is marked Secure:
# COOKIE_SECURE=1
# TRUST_PROXY=1
# Who may create an account: `invite` (the default: only emails added with `python main.py invite add ...`) or `open` (anyone). Use `open` on your own computer.
# SIGNUP_MODE=invite
# Let people press "Check for new jobs" to start a search themselves. Off by default: a search can score jobs with Claude, which costs money, so on the
# deployed site new jobs are found automatically once a day. Turn it on (MANUAL_REFRESH=on) on your own computer to test.
# MANUAL_REFRESH=off
# Shown on the privacy page as where to send questions (optional)
# CONTACT_EMAIL=
