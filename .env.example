# Copy this file to .env and paste your key. .env is git-ignored. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: federal jobs from USAJobs. Free key: https://developer.usajobs.gov/apirequest (use the same email here)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Optional: Adzuna job search (large US aggregator). Free keys: https://developer.adzuna.com  (then set feeds.adzuna.enabled: true)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: Jooble job search. Free key on request: https://jooble.org/api/about  (then set feeds.jooble.enabled: true)
JOOBLE_API_KEY=
