# Copy to .env on the server (next to docker-compose.yml), fill in, then: chmod 600 .env
# Never commit the real file.

# The address people open, without https:// (the domain must point at the server before you start)
DOMAIN=yourdomain.example

# The RDS database (see deploy/README.md for creating it)
DATABASE_URL=postgresql://jobfinder:PASSWORD@your-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/jobfinder

# Claude. Also set a monthly spend limit on this key's account in the Anthropic console.
ANTHROPIC_API_KEY=

# Sign in with Google (a public value). Add https://DOMAIN under "Authorized JavaScript origins" for it in Google Cloud.
GOOGLE_CLIENT_ID=

# Invite-only: only emails added with `invite add` can create an account. Do not change this for the alpha.
SIGNUP_MODE=invite

# Behind HTTPS: mark the session cookie Secure, and believe the proxy about the address used
COOKIE_SECURE=1
TRUST_PROXY=1

# Shown on the privacy page as the place to ask questions (optional)
CONTACT_EMAIL=
